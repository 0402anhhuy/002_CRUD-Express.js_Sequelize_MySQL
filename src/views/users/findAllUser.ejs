<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find All User</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>
<body>
    <table style="width:100%">
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
        <% for(let i=0; i < datalist.length; i++) { %>
        <tr>
            <td><%= datalist[i].email %></td>
            <td><%= datalist[i].firstName %></td>
            <td><%= datalist[i].lastName %></td>
            <td><%= datalist[i].address %></td>
            <td><a href="/edit-crud?id=<%= datalist[i].id %>">Edit</a>||
                href="/delete-crud?id=<%= datalist[i].id %>">Delete</a></td>
        </tr>
        <% } %>
    </table>

</body>
</html>